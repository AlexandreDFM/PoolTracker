#Remember to rename this file to .env and fill in the values
HOST=
PORT=
NODE_ENV=

# Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=

# Optional: origins allowed to call the API from another origin (comma-separated)
CORS_ORIGIN=
# Initial admin account, only used when the database has no admin
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
