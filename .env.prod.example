# Production Environment Variables for Docker Compose Testing
# Copy this file to .env.prod and update with your actual values

# Application Configuration
NODE_ENV=production

# Database Configuration
DB_HOST=db_host.example.com
DB_PORT=3306
DB_USER=pool_tracker_user
DB_PASSWORD=change-me-secure-password
DB_NAME=pool_tracker_prod

# MySQL Root Configuration
MYSQL_DATABASE=pool_tracker_prod
MYSQL_USER=pool_tracker_user
MYSQL_PASSWORD=change-me-secure-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PORT=3306

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here

# PHPMyAdmin Configuration
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=change-me-root-password
PMA_ABSOLUTE_URI=http://localhost:8080

# Application Ports (for reference)
CLIENT_PORT=80
SERVER_PORT=3001

# Remote Database Configuration (for db-manager.sh script)
# Use these variables to connect to remote/production database for backups
# If not set, the DB_* variables above will be used
REMOTE_DB_HOST=your-production-db-host.com
REMOTE_DB_PORT=3306
REMOTE_DB_USER=remote_user
REMOTE_DB_PASSWORD=change-me-remote-password
REMOTE_DB_NAME=pool_tracker_production
